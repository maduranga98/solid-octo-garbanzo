rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection rules
    match /users/{userId} {
      // Anyone authenticated can read user profiles
      allow read: if isAuthenticated();

      // Only the user can create their own document
      allow create: if isOwner(userId);

      // User can update their own document, or anyone can update specific counter fields
      allow update: if isAuthenticated()
        && (isOwner(userId) ||
            request.resource.data.keys().hasOnly(['followersCount', 'postCount', 'blockedUsers']));

      // Only the user can delete their own document
      allow delete: if isOwner(userId);

      // Bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow read, create, delete: if isOwner(userId);
        allow update: if false;
      }

      // Drafts subcollection
      match /drafts/{draftId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Followers subcollection
      match /followers/{followerId} {
        allow read: if isAuthenticated();
        allow create, delete: if isAuthenticated() && followerId == request.auth.uid;
        allow update: if false;
      }

      // Following subcollection
      match /following/{followingId} {
        allow read: if isAuthenticated();
        allow create, delete: if isOwner(userId);
        allow update: if false;
      }

      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated();
      }

      // Blocked users subcollection
      match /blockedUsers/{blockedUserId} {
        allow read, create, delete: if isOwner(userId);
        allow update: if false;
      }
    }

    // Posts collection rules
    match /posts/{postId} {
      // Anyone authenticated can read posts
      allow read: if isAuthenticated();

      // Authenticated users can create posts (must set createdBy to their uid)
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid;

      // Post owner can update, or anyone can update counter fields only
      allow update: if isAuthenticated()
        && (request.resource.data.createdBy == resource.data.createdBy
            && (resource.data.createdBy == request.auth.uid
                || request.resource.data.keys().hasOnly(['likeCount', 'shareCount', 'commentCount', 'viewCount'])));

      // Only post owner can delete
      allow delete: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;

      // Likes subcollection
      match /likes/{likeId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && likeId == request.auth.uid;
        allow delete: if isAuthenticated() && likeId == request.auth.uid;
        allow update: if false;
      }

      // Comments subcollection - FIXED to match actual app fields
      match /comments/{commentId} {
        allow read: if isAuthenticated();

        // App sends: authorId, authorName, text, postId, createdAt
        allow create: if isAuthenticated()
          && request.resource.data.authorId == request.auth.uid;

        // Comment author can update their own comment
        allow update: if isAuthenticated()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId;

        // Comment author or post owner can delete
        allow delete: if isAuthenticated()
          && (resource.data.authorId == request.auth.uid
              || get(/databases/$(database)/documents/posts/$(postId)).data.createdBy == request.auth.uid);

        // Replies subcollection
        match /replies/{replyId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated()
            && request.resource.data.authorId == request.auth.uid;
          allow update: if isAuthenticated()
            && resource.data.authorId == request.auth.uid;
          allow delete: if isAuthenticated()
            && (resource.data.authorId == request.auth.uid
                || get(/databases/$(database)/documents/posts/$(postId)).data.createdBy == request.auth.uid);
        }
      }
    }

    // Reports collection rules
    match /reports/{reportId} {
      // Users can read their own reports
      allow read: if isAuthenticated()
        && resource.data.reportedBy == request.auth.uid;

      // Any authenticated user can create a report
      allow create: if isAuthenticated()
        && request.resource.data.reportedBy == request.auth.uid;

      // Prevent updates
      allow update: if false;

      // Users can delete their own pending reports
      allow delete: if isAuthenticated()
        && resource.data.reportedBy == request.auth.uid;
    }

    // Chats collection rules
    match /chats/{chatId} {
      // Users can read chats they're part of
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.participants;

      // Users can create chats if they're a participant
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participants;

      // Users can update chats they're part of
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants;

      // Prevent deletion
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        // Users can read messages in their chats
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // Users can create messages in their chats (must be sender)
        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;

        // Prevent updates and deletes
        allow update, delete: if false;
      }
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
