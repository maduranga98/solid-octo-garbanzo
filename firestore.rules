rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // HELPER FUNCTIONS
    // ========================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the owner of a resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate string length
    function isValidString(value, minLen, maxLen) {
      return value is string
        && value.size() >= minLen
        && value.size() <= maxLen;
    }

    // Validate email format
    function isValidEmail(email) {
      return email is string
        && email.matches('.*@.*\\..*');
    }

    // Validate username format (3-30 chars, alphanumeric + underscore)
    function isValidUserName(userName) {
      return userName is string
        && userName.size() >= 3
        && userName.size() <= 30
        && userName.matches('^[a-zA-Z0-9_]+$');
    }

    // Validate timestamp field
    function isValidTimestamp(value) {
      return value is timestamp || value == request.time;
    }

    // Validate list/array
    function isValidList(value) {
      return value is list;
    }

    // ========================================
    // VALIDATION FUNCTIONS
    // ========================================

    // Validate core user fields on create
    // Note: photoURl has capital U to match app code
    function hasValidUserCoreFields() {
      let data = request.resource.data;
      return data.uid is string
        && data.uid == request.auth.uid
        && isValidString(data.firstname, 1, 50)
        && isValidString(data.lastname, 1, 50)
        && isValidEmail(data.email)
        && isValidUserName(data.userName)
        && data.postCount is int
        && data.followersCount is int
        && data.followingCount is int
        && data.isAgeVerified is bool
        && data.requiresParentalConsent is bool
        && data.parentalConsentGiven is bool
        // Optional fields - only validate if present
        && (!('bio' in data) || data.bio == null || isValidString(data.bio, 0, 500))
        && (!('photoURl' in data) || data.photoURl == null || data.photoURl is string)
        && (!('country' in data) || data.country == null || isValidString(data.country, 0, 100))
        && (!('fcmToken' in data) || data.fcmToken == null || data.fcmToken is string)
        && (!('type' in data) || data.type == null || isValidList(data.type))
        && (!('preferredReadingLanguages' in data) || data.preferredReadingLanguages == null || isValidList(data.preferredReadingLanguages))
        && (!('preferredWritingLanguage' in data) || data.preferredWritingLanguage == null || data.preferredWritingLanguage is string)
        && (!('exploreInternational' in data) || data.exploreInternational == null || data.exploreInternational is bool)
        && (!('blockedUsers' in data) || data.blockedUsers == null || isValidList(data.blockedUsers))
        && (!('dateOfBirth' in data) || data.dateOfBirth == null || isValidTimestamp(data.dateOfBirth))
        && (!('parentalConsentDate' in data) || data.parentalConsentDate == null || isValidTimestamp(data.parentalConsentDate));
    }

    // Validate core post fields
    function hasValidPostCoreFields() {
      let data = request.resource.data;
      return isValidString(data.title, 1, 200)
        && data.createdBy is string
        && data.createdBy == request.auth.uid
        && data.authorName is string
        && data.uid is string
        && data.workType is string
        && data.workType in ['Poetry', 'Lyrics', 'Stories', 'Quotes', 'Microfiction']
        // Optional fields
        && (!('description' in data) || data.description == null || isValidString(data.description, 0, 5000))
        && (!('plainText' in data) || data.plainText == null || data.plainText is string)
        && (!('richText' in data) || data.richText == null || data.richText is string)
        && (!('fontFamily' in data) || data.fontFamily == null || data.fontFamily is string)
        && (!('fontSize' in data) || data.fontSize == null || data.fontSize is int)
        && (!('likeCount' in data) || data.likeCount == null || data.likeCount is int)
        && (!('commentCount' in data) || data.commentCount == null || data.commentCount is int)
        && (!('shareCount' in data) || data.shareCount == null || data.shareCount is int)
        && (!('viewCount' in data) || data.viewCount == null || data.viewCount is int);
    }

    // Validate comment/reply fields
    // App sends: text, authorId, authorName, postId
    function hasValidCommentCoreFields() {
      let data = request.resource.data;
      return isValidString(data.text, 1, 1000)
        && data.authorId is string
        && data.authorId == request.auth.uid
        && data.authorName is string
        && data.postId is string;
    }

    // Validate idea fields
    function hasValidIdeaFields() {
      let data = request.resource.data;
      return (!('title' in data) || data.title == null || isValidString(data.title, 0, 100))
        && (!('description' in data) || data.description == null || isValidString(data.description, 0, 500));
    }

    // Check if update only modifies post counter fields
    function isPostCounterUpdate() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(['likeCount', 'shareCount', 'commentCount', 'viewCount']);
    }

    // Check if update only modifies followersCount
    function isFollowerCountUpdate() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(['followersCount']);
    }

    // Check if update only modifies followingCount
    function isFollowingCountUpdate() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(['followingCount']);
    }

    // Check if update only modifies postCount
    function isPostCountUpdate() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(['postCount']);
    }

    // Check if update only modifies blockedUsers array
    function isBlockedUsersUpdate() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(['blockedUsers']);
    }

    // Check if update only modifies fcmToken
    function isFCMTokenUpdate() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(['fcmToken'])
        && (request.resource.data.fcmToken == null || request.resource.data.fcmToken is string);
    }

    // ========================================
    // USERS COLLECTION
    // ========================================
    match /users/{userId} {
      // Any authenticated user can read user profiles
      allow get: if isAuthenticated();

      // Allow listing users for search and username availability checks
      // Required for signup flow (username uniqueness check)
      allow list: if true;

      // Only the user can create their own profile
      allow create: if isOwner(userId) && hasValidUserCoreFields();

      // Allow updates in these cases:
      // 1. Owner updating their profile
      // 2. Anyone updating followersCount (when someone follows/unfollows)
      // 3. Anyone updating followingCount (batch operations)
      // 4. Anyone updating postCount (when creating/deleting posts)
      // 5. Owner updating blockedUsers array
      // 6. Owner/System updating FCM token
      allow update: if isAuthenticated()
        && (
          // Owner can update their profile (preserving uid)
          (isOwner(userId) && request.resource.data.uid == userId)
          // OR counter updates
          || isFollowerCountUpdate()
          || isFollowingCountUpdate()
          || isPostCountUpdate()
          // OR owner updating blocked users
          || (isOwner(userId) && isBlockedUsersUpdate())
          // OR FCM token updates
          || (isOwner(userId) && isFCMTokenUpdate())
        );

      // Only the user can delete their profile
      allow delete: if isOwner(userId);

      // ----------------------------------------
      // BOOKMARKS SUBCOLLECTION
      // ----------------------------------------
      match /bookmarks/{bookmarkId} {
        // Only owner can read their bookmarks
        allow read: if isOwner(userId);

        // Only owner can create/delete bookmarks
        // Validates: postId, postTitle, postAuthor, bookmarkedAt
        allow create: if isOwner(userId)
          && request.resource.data.postId is string
          && request.resource.data.postTitle is string
          && request.resource.data.postAuthor is string
          && isValidTimestamp(request.resource.data.bookmarkedAt);

        allow delete: if isOwner(userId);

        // No updates allowed
        allow update: if false;
      }

      // ----------------------------------------
      // DRAFTS SUBCOLLECTION
      // ----------------------------------------
      match /drafts/{draftId} {
        // Only owner can read their drafts
        allow read: if isOwner(userId);

        // Only owner can create/update/delete drafts
        allow create, update, delete: if isOwner(userId);
      }

      // ----------------------------------------
      // IDEAS SUBCOLLECTION
      // ----------------------------------------
      match /ideas/{ideaId} {
        // Only owner can read their ideas
        allow read: if isOwner(userId);

        // Only owner can create ideas
        allow create: if isOwner(userId)
          && hasValidIdeaFields()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        // Only owner can update ideas
        allow update: if isOwner(userId)
          && hasValidIdeaFields()
          && request.resource.data.updatedAt == request.time
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt']);

        // Only owner can delete ideas
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // FOLLOWERS SUBCOLLECTION
      // ----------------------------------------
      match /followers/{followerId} {
        // Anyone can read followers
        allow read: if isAuthenticated();

        // Only the follower can create their follow relationship
        // followerId = the UID of the follower (document ID)
        // Data contains: followedAt timestamp
        allow create: if isAuthenticated()
          && followerId == request.auth.uid
          && request.resource.data.followedAt == request.time;

        // Only the follower can delete their follow relationship
        allow delete: if isAuthenticated()
          && followerId == request.auth.uid;

        // No updates allowed
        allow update: if false;
      }

      // ----------------------------------------
      // FOLLOWING SUBCOLLECTION
      // ----------------------------------------
      match /following/{followingId} {
        allow read: if isAuthenticated();

        // Only owner can manage their following list
        // followingId = UID of user being followed (document ID)
        // Data contains: followedAt timestamp
        allow create: if isOwner(userId)
          && request.resource.data.followedAt == request.time;

        allow delete: if isOwner(userId);

        // No updates allowed
        allow update: if false;
      }

      // ----------------------------------------
      // NOTIFICATIONS SUBCOLLECTION
      // ----------------------------------------
      match /notifications/{notificationId} {
        // Only owner can read their notifications
        allow read: if isOwner(userId);

        // Anyone can create notifications
        allow create: if isAuthenticated()
          && request.resource.data.recipientId == userId
          && request.resource.data.senderId is string
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ['like', 'comment', 'reply', 'follow', 'mention']
          && request.resource.data.isRead is bool
          && request.resource.data.createdAt == request.time;

        // Only owner can update (mark as read)
        allow update: if isOwner(userId)
          && request.resource.data.recipientId == userId;

        // Only owner can delete
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // BLOCKED USERS SUBCOLLECTION
      // ----------------------------------------
      match /blockedUsers/{blockedUserId} {
        // Only owner can read their blocked list
        allow read: if isOwner(userId);

        // Only owner can block users
        allow create: if isOwner(userId)
          && request.resource.data.blockedBy == request.auth.uid
          && request.resource.data.blockedUserId is string
          && request.resource.data.blockedUsername is string
          && request.resource.data.createdAt == request.time;

        // Only owner can unblock
        allow delete: if isOwner(userId);

        // No updates allowed
        allow update: if false;
      }
    }

    // ========================================
    // POSTS COLLECTION
    // ========================================
    match /posts/{postId} {
      // Any authenticated user can read posts
      allow read: if isAuthenticated();

      // Any authenticated user can create posts
      allow create: if isAuthenticated()
        && hasValidPostCoreFields()
        && request.resource.data.createdAt == request.time;

      // Allow updates in these cases:
      // 1. Post owner updating their post
      // 2. Anyone updating counter fields only
      allow update: if isAuthenticated()
        && (
          // Owner updating their post (preserving createdBy)
          (resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt']))
          // OR counter updates only
          || isPostCounterUpdate()
        );

      // Only post owner can delete
      allow delete: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;

      // ----------------------------------------
      // LIKES SUBCOLLECTION
      // ----------------------------------------
      match /likes/{likeId} {
        // Anyone can read likes
        allow read: if isAuthenticated();

        // Users can like posts (likeId = user's UID)
        allow create: if isAuthenticated()
          && likeId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.likedAt == request.time;

        // Users can unlike their own likes
        allow delete: if isAuthenticated()
          && likeId == request.auth.uid;

        // No updates allowed
        allow update: if false;
      }

      // ----------------------------------------
      // COMMENTS SUBCOLLECTION
      // ----------------------------------------
      match /comments/{commentId} {
        allow read: if isAuthenticated();

        // Anyone can create comments
        allow create: if isAuthenticated()
          && hasValidCommentCoreFields()
          && request.resource.data.createdAt == request.time;

        // Only comment owner can update
        allow update: if isAuthenticated()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt', 'postId']);

        // Comment owner OR post owner can delete
        allow delete: if isAuthenticated()
          && (resource.data.authorId == request.auth.uid
              || get(/databases/$(database)/documents/posts/$(postId)).data.createdBy == request.auth.uid);

        // ----------------------------------------
        // REPLIES SUBCOLLECTION (nested)
        // ----------------------------------------
        match /replies/{replyId} {
          // Anyone can read replies
          allow read: if isAuthenticated();

          // Anyone can create replies
          allow create: if isAuthenticated()
            && hasValidCommentCoreFields()
            && request.resource.data.createdAt == request.time;

          // Only reply owner can update
          allow update: if isAuthenticated()
            && resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt', 'postId']);

          // Reply owner, comment owner, OR post owner can delete
          allow delete: if isAuthenticated()
            && (resource.data.authorId == request.auth.uid
                || get(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)).data.authorId == request.auth.uid
                || get(/databases/$(database)/documents/posts/$(postId)).data.createdBy == request.auth.uid);
        }
      }
    }

    // ========================================
    // COMMENT LIKES COLLECTION (Top-level)
    // ========================================
    match /commentLikes/{likeId} {
      // Anyone can read comment likes
      allow read: if isAuthenticated();

      // Users can like comments
      // likeId format: {commentId}_{userId}
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.commentId is string
        && request.resource.data.postId is string
        && request.resource.data.likedAt == request.time;

      // Users can delete their own comment likes
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // No updates allowed
      allow update: if false;
    }

    // ========================================
    // REPORTS COLLECTION
    // ========================================
    match /reports/{reportId} {
      // Users can read their own reports
      allow read: if isAuthenticated()
        && resource.data.reportedBy == request.auth.uid;

      // Any authenticated user can create reports
      allow create: if isAuthenticated()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.reporterEmail is string
        && request.resource.data.reporterName is string
        && request.resource.data.reportType in ['post', 'comment', 'profile', 'message']
        && request.resource.data.reason in ['harassment', 'spam', 'inappropriateContent', 'violence', 'hateSpeech', 'childSafety', 'sexualContent', 'falseInformation', 'other']
        && isValidString(request.resource.data.description, 10, 500)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      // Only admins can update (via Firebase Console or Admin SDK)
      allow update: if false;

      // Users can delete their own pending reports
      allow delete: if isAuthenticated()
        && resource.data.reportedBy == request.auth.uid;
    }

    // ========================================
    // CHATS COLLECTION
    // ========================================
    match /chats/{chatId} {
      // Users can read chats they're part of
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.participants;

      // Users can create chats if they're a participant
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participants;

      // Participants can update chat metadata (last message, unread count)
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      // No deletes allowed (or only by admins via console)
      allow delete: if false;

      // ----------------------------------------
      // MESSAGES SUBCOLLECTION
      // ----------------------------------------
      match /messages/{messageId} {
        // Participants can read messages
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // Participants can create messages
        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && isValidString(request.resource.data.text, 1, 1000)
          && request.resource.data.sentAt == request.time;

        // No updates or deletes allowed
        allow update, delete: if false;
      }
    }

    // ========================================
    // FALLBACK RULE - Deny all other access
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
