# Firebase Configuration
# Copy this file to .env and fill in your actual Firebase credentials
# Get these values from your Firebase Console and google-services.json

# Android Configuration
APIKEY=your_android_api_key_here
APP_ID_ANDROID=your_android_app_id_here
MESSAGING_SENDER_ID=your_messaging_sender_id_here
STORAGE_BUCKET=your_storage_bucket_here

# iOS Configuration
API_KEY_IOS=your_ios_api_key_here
APP_ID_IOS=your_ios_app_id_here
MESSAGING_SENDER_ID_IOS=your_ios_messaging_sender_id_here
IOS_CLIENT_ID=your_ios_client_id_here
